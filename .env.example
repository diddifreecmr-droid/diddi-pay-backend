# --- Ports hôte ---------------------------------------------------------------
# Ce projet est destiné à être hébergé aux côtés d'autres piles complètes (Postgres, Redis,
# Flask, ...) sur le même serveur. NE JAMAIS garder ces valeurs sans vérifier au préalable
# qu'elles sont libres sur la machine cible :
#   ss -tulpn | grep <port>
#   docker ps --format "{{.Names}}: {{.Ports}}"
# Modifier uniquement ici (docker-compose.yml lit ces variables) — et reporter la même valeur
# dans DATABASE_URL / REDIS_URL / TEST_DATABASE_URL ci-dessous, qui ne font pas de substitution
# automatique.
POSTGRES_PORT=54329
REDIS_PORT=61780
# Port d'écoute de l'API elle-même (voir README pour la commande de démarrage). Ne pas laisser
# au 8000 par défaut d'uvicorn sans vérifier qu'il est libre sur la machine cible.
APP_PORT=48213

# Postgres et Redis ne doivent jamais être publics. Pour APP_BIND_HOST, utiliser 127.0.0.1 si le
# reverse proxy tourne sur l'hôte ; garder 0.0.0.0 seulement si le réseau/proxy l'exige et si le
# firewall bloque APP_PORT depuis Internet.
POSTGRES_BIND_HOST=127.0.0.1
REDIS_BIND_HOST=127.0.0.1
APP_BIND_HOST=0.0.0.0

# Observabilite OBS-1. RELEASE_SHA doit etre remplace par le SHA Git de l'image deployee.
# Le endpoint /internal/metrics n'est actif que si METRICS_ENABLED=true et exige alors un
# Bearer token aleatoire d'au moins 32 caracteres, injecte par la plateforme de deploiement.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_ENVIRONMENT=staging
OBSERVABILITY_SERVICE_NAME=diddipay
OBSERVABILITY_RELEASE_SHA=replace-with-git-sha
LOG_LEVEL=INFO
METRICS_ENABLED=false
METRICS_TOKEN=
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=http://otel-collector:4318
# 0.1 = 10 % des nouvelles traces, mais 100 % d'une trace deja echantillonnee par DiddiGo.
TRACING_SAMPLE_RATE=0.1

# Stack optionnelle `docker-compose.observability.yml`, liee uniquement a l'hote local.
PROMETHEUS_PORT=49090
GRAFANA_PORT=43000
ALERTMANAGER_PORT=49093
TEMPO_PORT=43200
LOKI_PORT=43100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
METRICS_TOKEN_FILE=./.secrets/metrics_token
ALERT_WEBHOOK_URL_FILE=./.secrets/alert_webhook_url

# Base de données — doit correspondre à POSTGRES_PORT ci-dessus.
DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:54329/payfund

# DiddiFreeID — vérification locale du token (voir DiddiFreeID_Contrat_API.md §2)
DIDDIFREEID_JWKS_URL=https://auth-staging.diddifree.com/identity/v1/.well-known/jwks.json
DIDDIFREEID_ISSUER=diddifree-id
DIDDIFREEID_STEP_UP_MAX_TTL_SECONDS=300

# Bus d'événements — Redis Pub/Sub au démarrage (DiddiFreeID_Contrat_API.md §4). Doit
# correspondre à REDIS_PORT ci-dessus.
REDIS_URL=redis://localhost:61780/0
EVENT_BUS_CHANNEL=diddifree.events

# Passerelles du wallet legacy uniquement : "stub" pour la simulation générique,
# "sandbox_orange_money" ou "sandbox_wave" pour valider explicitement un rail avant intégration
# réelle, "paystack" pour les dépôts Paystack réels uniquement (exige PAYSTACK_SECRET_KEY).
# Le retrait Paystack n'est pas implémenté et renvoie WITHDRAWAL_NOT_SUPPORTED.
PAYMENT_GATEWAY_MODE=stub
# Toujours false avec un provider réel : seul son webhook ou la réconciliation finalise le paiement.
PAYMENT_GATEWAY_AUTOCONFIRM=false

# Paystack, utilisé par le wallet legacy et par le nouvel orchestrateur selon les modes activés.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# S2S PaymentIntent : une cle par backend appelant, jamais dans le frontend.
# Vide = aucun module autorise. Fournir les vraies valeurs via les secrets du deploiement.
# Exemple : diddigo:<cle-go>,diddifund:<cle-fund>,diddisend:<cle-send>,diddifiles:<cle-files>
# La cle du module doit etre identique a son DIDDIPAY_SERVICE_KEY cote appelant.
# DiddiSend staging utilise X-Client-ID=diddisend. Son backend doit definir :
# DIDDIPAY_CLIENT_ID=diddisend
# DIDDIPAY_SERVICE_KEY=<meme-valeur-que-payment-service-keys-diddisend>
# DIDDIPAY_BASE_URL=https://pay-api-staging.diddifree.com/payfund/v1
# Voir S2S_Integration_Brief.md pour la configuration et les tests.
PAYMENT_SERVICE_KEYS=
# "sandbox" fonctionne sans clé externe ; "paystack" exige PAYSTACK_SECRET_KEY.
PAYMENT_PROCESSOR_MODE=sandbox
# Objet JSON indexé par X-Client-ID. Secret HMAC distinct de la cle S2S, >= 16 caracteres.
# HTTP n'est accepté que pour localhost ou le réseau Docker ; toute cible externe doit être HTTPS.
# Exemple : {"diddigo":{"url":"https://go-staging.diddifree.com/internal/webhooks/diddipay","secret":"<secret-callback-go>"},"diddifund":{"url":"http://app:8000/payfund/v1/fund/payments/webhooks/diddipay","secret":"<secret-callback-fund>"},"diddisend":{"url":"<url-callback-diddisend-validee>","secret":"<secret-callback-send>"}}
# Ajouter un futur module sous son propre client_id et son URL de callback.
# Ne configurer une cible que lorsque le module expose cette route et partage le secret HMAC correspondant.
PAYMENT_CALLBACK_TARGETS={}
PAYMENT_SUMMARY_AUDIENCE=diddipay
PAYMENT_SUMMARY_SCOPE=diddipay:payment-summary:read
# Compatibilite temporaire avec les premiers tokens Pilotage. Vider apres migration.
PAYMENT_SUMMARY_LEGACY_SCOPE=payment-summary:read
PAYMENT_SUMMARY_CLIENT_ID=
BACKOFFICE_AUDIENCE=diddipay
BACKOFFICE_CLIENT_IDS=
BACKOFFICE_READ_SCOPE=diddipay:operations:read
BACKOFFICE_COMMAND_SCOPE=diddipay:operations:write
# Si DiddiFund partage ce deploiement, meme valeur que PAYMENT_CALLBACK_TARGETS.diddifund.secret.
DIDDIFUND_DIDDIPAY_CALLBACK_SECRET=

# Politique de risque DiddiPay : un transfert de ce montant ou plus exige une preuve step-up
# DiddiFreeID signee avec purpose=wallet.transfer.high_value.
WALLET_STEP_UP_THRESHOLD_XOF=50000

# Paramètres métier et diagnostic. SQL_ECHO doit rester false hors développement local.
DEFAULT_INTEREST_RATE=6.5
SQL_ECHO=false

# Base utilisée par la suite de tests (créée/réinitialisée automatiquement). Doit correspondre
# à POSTGRES_PORT ci-dessus.
TEST_DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:54329/payfund_test

# Signature HMAC des QR codes de paiement marchand — À CHANGER EN PRODUCTION.
QR_SIGNING_SECRET=change-me-in-production

# Origines autorisées en CORS (frontend Flutter Web). "*" par défaut pour ne pas bloquer le dev
# local ; à restreindre aux domaines réels avant toute mise en production, ex. :
# CORS_ORIGINS=https://app.diddipay.com,https://staging.diddipay.com
CORS_ORIGINS=*

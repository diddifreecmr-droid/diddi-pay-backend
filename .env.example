# --- Ports hôte ---------------------------------------------------------------
# Ce projet est destiné à être hébergé aux côtés d'autres piles complètes (Postgres, Redis,
# Flask, ...) sur le même serveur. NE JAMAIS garder ces valeurs sans vérifier au préalable
# qu'elles sont libres sur la machine cible :
#   ss -tulpn | grep <port>
#   docker ps --format "{{.Names}}: {{.Ports}}"
# Modifier uniquement ici (docker-compose.yml lit ces variables) — et reporter la même valeur
# dans DATABASE_URL / REDIS_URL / TEST_DATABASE_URL ci-dessous, qui ne font pas de substitution
# automatique.
POSTGRES_PORT=54329
REDIS_PORT=61780
# Port d'écoute de l'API elle-même (voir README pour la commande de démarrage). Ne pas laisser
# au 8000 par défaut d'uvicorn sans vérifier qu'il est libre sur la machine cible.
APP_PORT=48213

# Base de données — doit correspondre à POSTGRES_PORT ci-dessus.
DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:54329/payfund

# DiddiFreeID — vérification locale du token (voir DiddiFreeID_Contrat_API.md §2)
DIDDIFREEID_JWKS_URL=https://auth-staging.diddifree.com/identity/v1/.well-known/jwks.json
DIDDIFREEID_ISSUER=diddifree-id
DIDDIFREEID_STEP_UP_MAX_TTL_SECONDS=300

# Bus d'événements — Redis Pub/Sub au démarrage (DiddiFreeID_Contrat_API.md §4). Doit
# correspondre à REDIS_PORT ci-dessus.
REDIS_URL=redis://localhost:61780/0
EVENT_BUS_CHANNEL=diddifree.events

# Passerelles Mobile Money du wallet legacy uniquement : "stub" pour la simulation générique, ou
# "sandbox_orange_money" pour valider explicitement le rail Orange Money avant intégration réelle.
PAYMENT_GATEWAY_MODE=stub
# Toujours false avec un provider réel : seul son webhook ou la réconciliation finalise le paiement.
PAYMENT_GATEWAY_AUTOCONFIRM=false

# Paystack, utilisé par le wallet legacy et par le nouvel orchestrateur selon les modes activés.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# Credentials service-to-service for the PaymentIntent API.
# Use different random secrets per environment and rotate them independently.
PAYMENT_SERVICE_KEYS=diddigo:replace-me,diddifund:replace-me
# "sandbox" fonctionne sans clé externe ; "paystack" exige PAYSTACK_SECRET_KEY.
PAYMENT_PROCESSOR_MODE=sandbox
# Objet JSON indexé par X-Client-ID. Utiliser des secrets indépendants d'au moins 16 caractères.
# HTTP n'est accepté que pour localhost ou le réseau Docker ; toute cible externe doit être HTTPS.
# Exemple monolithe DiddiFund :
# PAYMENT_CALLBACK_TARGETS={"diddifund":{"url":"http://app:8000/payfund/v1/fund/payments/webhooks/diddipay","secret":"replace-with-at-least-16-chars"}}
PAYMENT_CALLBACK_TARGETS={}
# Must match the `diddifund` target secret when this monolith receives its callback.
DIDDIFUND_DIDDIPAY_CALLBACK_SECRET=

# Politique de risque DiddiPay : un transfert de ce montant ou plus exige une preuve step-up
# DiddiFreeID signee avec purpose=wallet.transfer.high_value.
WALLET_STEP_UP_THRESHOLD_XOF=50000

# Paramètres métier et diagnostic. SQL_ECHO doit rester false hors développement local.
DEFAULT_INTEREST_RATE=6.5
SQL_ECHO=false

# Base utilisée par la suite de tests (créée/réinitialisée automatiquement). Doit correspondre
# à POSTGRES_PORT ci-dessus.
TEST_DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:54329/payfund_test

# Signature HMAC des QR codes de paiement marchand — À CHANGER EN PRODUCTION.
QR_SIGNING_SECRET=change-me-in-production

# Origines autorisées en CORS (frontend Flutter Web). "*" par défaut pour ne pas bloquer le dev
# local ; à restreindre aux domaines réels avant toute mise en production, ex. :
# CORS_ORIGINS=https://app.diddipay.com,https://staging.diddipay.com
CORS_ORIGINS=*

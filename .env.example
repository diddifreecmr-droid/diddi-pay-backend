# Base de données — instance dédiée du docker-compose du projet (port 5434 : 5432 et 5433 sont
# déjà occupés par les projets abidjan-map et diddi-go sur ce poste).
DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:5434/payfund

# DiddiFreeID — vérification locale du token (voir DiddiFreeID_Contrat_API.md §2)
DIDDIFREEID_JWKS_URL=https://api-dev.diddifree.app/identity/v1/.well-known/jwks.json

# Bus d'événements — Redis Pub/Sub au démarrage (DiddiFreeID_Contrat_API.md §4)
REDIS_URL=redis://localhost:6380/0
EVENT_BUS_CHANNEL=diddifree.events

# Passerelles Mobile Money : "stub" tant que Orange Money / MTN réels ne sont pas branchés
# (Architecture §7, étape 2)
PAYMENT_GATEWAY_MODE=stub

# Base utilisée par la suite de tests (créée/réinitialisée automatiquement)
TEST_DATABASE_URL=postgresql+psycopg://payfund:payfund@localhost:5434/payfund_test

# Signature HMAC des QR codes de paiement marchand — À CHANGER EN PRODUCTION.
QR_SIGNING_SECRET=change-me-in-production

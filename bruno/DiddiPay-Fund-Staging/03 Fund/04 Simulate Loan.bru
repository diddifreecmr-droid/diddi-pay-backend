meta {
  name: Simulate Loan
  type: http
  seq: 4
}

post {
  url: {{payfundBaseUrl}}/fund/loans/simulate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "amount": 100000,
    "duration_months": 12
  }
}

tests {
  test("simulated", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("terms look sane", function() {
    const body = res.getBody();
    expect(body.principal).to.equal(100000);
    expect(body.monthly_installment).to.be.above(0);
    expect(body.total_repayable).to.be.at.least(body.principal);
  });
}

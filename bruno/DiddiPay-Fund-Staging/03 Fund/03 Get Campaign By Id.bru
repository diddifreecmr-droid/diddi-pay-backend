meta {
  name: Get Campaign By Id
  type: http
  seq: 3
}

get {
  url: {{payfundBaseUrl}}/fund/campaigns/{{campaignId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test("found", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("owned by user A", function() {
    expect(res.getBody().owner_user_id).to.equal(bru.getVar("userAId") || bru.getEnvVar("userAId"));
  });
}

docs {
  Needs `campaignId` — run `01 Create Campaign` first.
}

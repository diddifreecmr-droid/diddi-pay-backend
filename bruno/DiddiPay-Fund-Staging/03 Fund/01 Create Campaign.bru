meta {
  name: Create Campaign
  type: http
  seq: 1
}

post {
  url: {{payfundBaseUrl}}/fund/campaigns
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "title": "Bruno Demo Campaign",
    "goal_amount": 1000000
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("campaignId", res.getBody().campaign_id);
  }
}

tests {
  test("created in draft", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

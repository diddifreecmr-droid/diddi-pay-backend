meta {
  name: OpenAPI Payment Contract
  type: http
  seq: 1
}

get {
  url: {{payfundBaseUrl}}/openapi.json
  body: none
  auth: none
}

tests {
  test("OpenAPI document is reachable", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().openapi).to.be.a("string");
  });

  test("the complete MVP API surface is deployed", function() {
    const paths = res.getBody().paths || {};
    const required = [
      ["post", "/payfund/v1/fund/campaigns"],
      ["get", "/payfund/v1/fund/campaigns"],
      ["get", "/payfund/v1/fund/campaigns/{campaign_id}"],
      ["post", "/payfund/v1/fund/campaigns/{campaign_id}/invest"],
      ["post", "/payfund/v1/fund/campaigns/{campaign_id}/invest/payment"],
      ["post", "/payfund/v1/fund/loans"],
      ["post", "/payfund/v1/fund/loans/simulate"],
      ["get", "/payfund/v1/fund/loans/{loan_id}"],
      ["post", "/payfund/v1/fund/loans/{loan_id}/repay"],
      ["get", "/payfund/v1/fund/loans/{loan_id}/schedule"],
      ["get", "/payfund/v1/fund/payment-orders/{order_id}"],
      ["post", "/payfund/v1/fund/payments/webhooks/diddipay"],
      ["get", "/payfund/v1/health"],
      ["post", "/payfund/v1/payment-intents"],
      ["get", "/payfund/v1/payment-intents"],
      ["get", "/payfund/v1/payment-intents/{intent_id}"],
      ["post", "/payfund/v1/payment-intents/{intent_id}/cancel"],
      ["get", "/payfund/v1/payment-intents/{intent_id}/financial-summary"],
      ["post", "/payfund/v1/payment-intents/{intent_id}/refunds"],
      ["post", "/payfund/v1/payments/webhooks/paystack"],
      ["get", "/payfund/v1/ready"],
      ["get", "/payfund/v1/wallet/balance"],
      ["post", "/payfund/v1/wallet/deposit"],
      ["post", "/payfund/v1/wallet/ops/backfill"],
      ["post", "/payfund/v1/wallet/ops/kyc/link"],
      ["get", "/payfund/v1/wallet/ops/kyc/{user_id}"],
      ["get", "/payfund/v1/wallet/ops/outbox"],
      ["post", "/payfund/v1/wallet/ops/outbox/relay"],
      ["get", "/payfund/v1/wallet/ops/paystack/pending"],
      ["post", "/payfund/v1/wallet/ops/paystack/reconcile/{transaction_id}"],
      ["get", "/payfund/v1/wallet/ops/paystack/summary"],
      ["get", "/payfund/v1/wallet/ops/paystack/{transaction_id}"],
      ["get", "/payfund/v1/wallet/ops/paystack/{transaction_id}/reconciliations"],
      ["post", "/payfund/v1/wallet/ops/pin/reset"],
      ["get", "/payfund/v1/wallet/ops/provisioning/{user_id}"],
      ["post", "/payfund/v1/wallet/pay/merchant"],
      ["get", "/payfund/v1/wallet/pin"],
      ["post", "/payfund/v1/wallet/pin/change"],
      ["post", "/payfund/v1/wallet/pin/reset"],
      ["post", "/payfund/v1/wallet/pin/set"],
      ["post", "/payfund/v1/wallet/qr/generate"],
      ["post", "/payfund/v1/wallet/qr/verify"],
      ["get", "/payfund/v1/wallet/recipient/lookup"],
      ["get", "/payfund/v1/wallet/transactions"],
      ["get", "/payfund/v1/wallet/transactions/{transaction_id}"],
      ["post", "/payfund/v1/wallet/transfer"],
      ["post", "/payfund/v1/wallet/webhooks/paystack"],
      ["post", "/payfund/v1/wallet/withdraw"]
    ];
    const missing = required
      .filter(([method, path]) => !paths[path]?.[method])
      .map(([method, path]) => method.toUpperCase() + " " + path);
    expect(missing, "Missing staging operations: " + missing.join(", ")).to.deep.equal([]);
  });

  test("Paystack webhook body and signature are documented", function() {
    const operation = res.getBody().paths?.["/payfund/v1/payments/webhooks/paystack"]?.post;
    expect(operation, "Paystack webhook operation is missing").to.exist;
    if (operation) {
      expect(operation.requestBody?.required).to.equal(true);
      const headers = (operation.parameters || []).map((item) => item.name);
      expect(headers).to.include("X-Paystack-Signature");
    }
  });
}

docs {
  This is the deployment gate. A 200 response is not enough: the assertions compare every MVP
  method and path with the contract generated by the current application.
}

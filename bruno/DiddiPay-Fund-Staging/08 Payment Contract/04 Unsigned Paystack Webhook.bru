meta {
  name: Unsigned Paystack Webhook
  type: http
  seq: 4
}

post {
  url: {{payfundBaseUrl}}/payments/webhooks/paystack
  body: json
  auth: none
}

body:json {
  {
    "event": "charge.success",
    "data": {
      "reference": "forged-bruno-event",
      "amount": 100000,
      "currency": "XOF",
      "status": "success"
    }
  }
}

tests {
  test("unsigned provider webhook is rejected", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("UNAUTHENTICATED");
  });
}

docs {
  This request is intentionally unsigned and cannot change financial state.
}

meta {
  name: Deposit Invalid Provider
  type: http
  seq: 1
}

post {
  url: {{payfundBaseUrl}}/wallet/deposit
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "provider": "bitcoin",
    "amount": 1000,
    "phone": "+2250700000000"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("rejected", function() {
    expect(res.getStatus()).to.equal(422);
  });
}

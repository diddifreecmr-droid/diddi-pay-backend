meta {
  name: Get PaymentIntent
  type: http
  seq: 4
}

get {
  url: {{payfundBaseUrl}}/payment-intents/{{paymentIntentId}}
  body: none
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
}

tests {
  test("owner can read the intent", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("paymentIntentId"));
  });
}

meta {
  name: Unsupported Network
  type: http
  seq: 11
}

post {
  url: {{payfundBaseUrl}}/payment-intents
  body: json
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
  Idempotency-Key: invalid-network:{{paymentTestRunId}}
}

body:json {
  {
    "business_reference": "invalid-network:{{paymentTestRunId}}",
    "amount": 1000,
    "currency": "XOF",
    "channel": "mobile_money",
    "network": "bitcoin"
  }
}

tests {
  test("schema rejects unknown network", function() {
    expect(res.getStatus()).to.equal(422);
  });
}

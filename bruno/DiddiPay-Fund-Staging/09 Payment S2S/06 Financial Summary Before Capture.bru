meta {
  name: Financial Summary Before Capture
  type: http
  seq: 6
}

get {
  url: {{payfundBaseUrl}}/payment-intents/{{paymentIntentId}}/financial-summary
  body: none
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
}

tests {
  test("uncaptured payment has no financial postings", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.payment_intent_id).to.equal(bru.getVar("paymentIntentId"));
    expect(body.gross_captured).to.equal(0);
    expect(body.refunded).to.equal(0);
    expect(body.processor_fees).to.equal(0);
    expect(body.settled).to.equal(0);
    expect(body.outstanding).to.equal(0);
  });
}

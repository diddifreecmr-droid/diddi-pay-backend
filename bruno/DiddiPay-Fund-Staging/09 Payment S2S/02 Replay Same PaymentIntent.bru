meta {
  name: Replay Same PaymentIntent
  type: http
  seq: 2
}

post {
  url: {{payfundBaseUrl}}/payment-intents
  body: json
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
  Idempotency-Key: {{paymentIdempotencyKey}}
}

body:json {
  {
    "business_reference": "{{paymentBusinessReference}}",
    "amount": 2500,
    "currency": "XOF",
    "channel": "mobile_money",
    "network": "orange",
    "customer_email": "{{paymentCustomerEmail}}",
    "description": "Bruno staging PaymentIntent",
    "metadata": {
      "test_run_id": "{{paymentTestRunId}}"
    }
  }
}

tests {
  test("same request returns the original intent", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.equal(bru.getVar("paymentIntentId"));
    expect(res.getBody().attempts).to.have.length(1);
  });
}

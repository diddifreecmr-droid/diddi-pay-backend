meta {
  name: Missing Idempotency Key
  type: http
  seq: 10
}

post {
  url: {{payfundBaseUrl}}/payment-intents
  body: json
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
}

body:json {
  {
    "business_reference": "missing-idempotency:{{paymentTestRunId}}",
    "amount": 1000,
    "currency": "XOF"
  }
}

tests {
  test("idempotency header is mandatory", function() {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("IDEMPOTENCY_KEY_REQUIRED");
  });
}

meta {
  name: Refund Uncaptured Payment
  type: http
  seq: 9
}

post {
  url: {{payfundBaseUrl}}/payment-intents/{{paymentIntentId}}/refunds
  body: json
  auth: none
}

headers {
  X-Client-ID: {{paymentClientId}}
  X-Service-Key: {{paymentServiceKey}}
  Idempotency-Key: refund:{{paymentTestRunId}}
}

body:json {
  {
    "amount": 500,
    "reason": "Bruno must reject refund before capture"
  }
}

tests {
  test("uncaptured payment cannot be refunded", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error.code).to.equal("PAYMENT_OPERATION_CONFLICT");
  });
}

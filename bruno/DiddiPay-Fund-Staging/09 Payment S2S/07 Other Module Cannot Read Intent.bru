meta {
  name: Other Module Cannot Read Intent
  type: http
  seq: 7
}

get {
  url: {{payfundBaseUrl}}/payment-intents/{{paymentIntentId}}
  body: none
  auth: none
}

headers {
  X-Client-ID: {{otherPaymentClientId}}
  X-Service-Key: {{otherPaymentServiceKey}}
}

script:pre-request {
  const serviceKey = bru.getProcessEnv("BRUNO_DIDDIFUND_SERVICE_KEY");
  if (!serviceKey) {
    throw new Error("BRUNO_DIDDIFUND_SERVICE_KEY is required for ownership isolation");
  }
  bru.setVar("otherPaymentServiceKey", serviceKey);
}

tests {
  test("another module receives not found without data leakage", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error.code).to.equal("PAYMENT_INTENT_NOT_FOUND");
  });
}

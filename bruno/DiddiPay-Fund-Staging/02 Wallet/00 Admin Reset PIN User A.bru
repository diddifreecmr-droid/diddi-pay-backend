meta {
  name: Admin Reset PIN User A
  type: http
  seq: 0
}

post {
  url: {{payfundBaseUrl}}/wallet/ops/pin/reset
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "user_id": "{{userAId}}",
    "new_pin": "{{walletPinA}}",
    "confirm_new_pin": "{{walletPinA}}",
    "reason": "Bruno staging test setup"
  }
}

script:pre-request {
  const adminToken = bru.getProcessEnv("BRUNO_ADMIN_ACCESS_TOKEN");
  const pin = bru.getProcessEnv("BRUNO_WALLET_PIN_A");
  if (!adminToken || !pin) {
    throw new Error("BRUNO_ADMIN_ACCESS_TOKEN and BRUNO_WALLET_PIN_A are required for legacy debit tests");
  }
  bru.setVar("adminAccessToken", adminToken);
  bru.setVar("walletPinA", pin);
}

tests {
  test("user A PIN is ready for debit tests", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
    bru.setVar("recoveryCodeA", res.getBody().recovery_codes?.[0]);
  });
}

docs {
  This is an audited staging-only setup operation. Never use a shared or production PIN.
}

meta {
  name: Withdraw
  type: http
  seq: 6
}

post {
  url: {{payfundBaseUrl}}/wallet/withdraw
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "provider": "orange_money",
    "amount": 1000,
    "phone": "+2250700000000",
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("accepted, or correctly refused for insufficient balance", function() {
    expect(res.getStatus()).to.be.oneOf([202, 409]);
  });
}

docs {
  Same gateway-mode caveat as `Transfer To User B`.
}

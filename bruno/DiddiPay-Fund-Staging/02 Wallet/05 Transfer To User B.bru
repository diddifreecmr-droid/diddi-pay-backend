meta {
  name: Transfer To User B
  type: http
  seq: 5
}

post {
  url: {{payfundBaseUrl}}/wallet/transfer
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "recipient_phone": "{{userBPhone}}",
    "amount": 1000,
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("completed, or correctly refused for insufficient balance", function() {
    expect(res.getStatus()).to.be.oneOf([201, 409]);
  });
}

docs {
  Whether this actually completes (201) rather than 409 `INSUFFICIENT_BALANCE` depends on staging's `PAYMENT_GATEWAY_MODE` / autoconfirm setting — deposits may stay `pending` forever without a real webhook. Both outcomes are correct API behaviour.
}

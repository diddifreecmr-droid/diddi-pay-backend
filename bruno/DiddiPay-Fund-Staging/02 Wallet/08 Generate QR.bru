meta {
  name: Generate QR
  type: http
  seq: 8
}

post {
  url: {{payfundBaseUrl}}/wallet/qr/generate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenB}}
}

body:json {
  {
    "merchant_account_id": "{{merchantAccountId}}",
    "amount": 500
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("qrPayload", res.getBody().payload);
  }
}

tests {
  test("generated by its owner (B), or not-found without the admin backfill", function() {
    expect(res.getStatus()).to.be.oneOf([201, 404]);
  });
}

docs {
  User B owns the merchant account backfilled above, so B — not A — generates its QR.
}

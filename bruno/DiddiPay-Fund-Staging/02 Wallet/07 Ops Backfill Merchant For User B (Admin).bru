meta {
  name: Ops Backfill Merchant For User B (Admin)
  type: http
  seq: 7
}

post {
  url: {{payfundBaseUrl}}/wallet/ops/backfill
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "user_id": "{{userBId}}",
    "account_type": "merchant"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("merchantAccountId", res.getBody().account_id);
  }
}

tests {
  test("provisioned, or correctly refused without admin creds", function() {
    expect(res.getStatus()).to.be.oneOf([200, 401]);
  });
}

docs {
  Requires `adminAccessToken` (admin tokens are minted offline per DiddiFreeID_Contrat_API.md §3, not obtainable from this collection). Without it, 401 is expected — the QR/pay-merchant requests below then have no `merchantAccountId` to use and fall back to their 404 branch.
}

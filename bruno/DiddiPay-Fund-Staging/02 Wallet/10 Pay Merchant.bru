meta {
  name: Pay Merchant
  type: http
  seq: 10
}

post {
  url: {{payfundBaseUrl}}/wallet/pay/merchant
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "merchant_account_id": "{{merchantAccountId}}",
    "amount": 500,
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("paid, or correctly refused (unfunded/no merchant)", function() {
    expect(res.getStatus()).to.be.oneOf([201, 404, 409]);
  });
}

meta {
  name: Admin Reset PIN User B
  type: http
  seq: 0
}

post {
  url: {{payfundBaseUrl}}/wallet/ops/pin/reset
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "user_id": "{{userBId}}",
    "new_pin": "{{walletPinB}}",
    "confirm_new_pin": "{{walletPinB}}",
    "reason": "Bruno staging test setup"
  }
}

script:pre-request {
  const pin = bru.getProcessEnv("BRUNO_WALLET_PIN_B");
  if (!pin) {
    throw new Error("BRUNO_WALLET_PIN_B is required for legacy DiddiFund debit tests");
  }
  bru.setVar("walletPinB", pin);
}

tests {
  test("user B PIN is ready for debit tests", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
    bru.setVar("recoveryCodeB", res.getBody().recovery_codes?.[0]);
  });
}

meta {
  name: Verify QR
  type: http
  seq: 9
}

post {
  url: {{payfundBaseUrl}}/wallet/qr/verify
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "payload": "{{qrPayload}}"
  }
}

tests {
  test("decoded, or correctly rejected if empty/absent", function() {
    expect(res.getStatus()).to.be.oneOf([200, 422]);
  });
}

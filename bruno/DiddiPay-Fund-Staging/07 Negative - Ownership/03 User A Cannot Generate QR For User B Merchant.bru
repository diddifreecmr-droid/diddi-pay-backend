meta {
  name: User A Cannot Generate QR For User B Merchant
  type: http
  seq: 3
}

post {
  url: {{payfundBaseUrl}}/wallet/qr/generate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "merchant_account_id": "{{merchantAccountId}}"
  }
}

tests {
  test("returns 403 NOT_MERCHANT_ACCOUNT_OWNER", function() {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("NOT_MERCHANT_ACCOUNT_OWNER");
  });
}

docs {
  Needs `merchantAccountId` (owned by B) — run `02 Wallet/07 Ops Backfill Merchant For User B` first. This one *is* 403 — the resource's existence is not secret, only acting on it is.
}

meta {
  name: User B Cannot See User A Transaction
  type: http
  seq: 1
}

get {
  url: {{payfundBaseUrl}}/wallet/transactions/{{transactionId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenB}}
}

tests {
  test("returns 404 TRANSACTION_NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("TRANSACTION_NOT_FOUND");
  });
}

docs {
  Needs `transactionId` — run `02 Wallet/02 Deposit` (as A) first. Must be 404, never 403: the API doesn't confirm to B that a transaction belonging to someone else even exists.
}

meta {
  name: Verify OTP User B
  type: http
  seq: 6
}

post {
  url: {{identityBaseUrl}}/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userBEmail}}",
    "code": "{{otpCodeB}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setVar("accessTokenB", body.access_token);
    bru.setVar("refreshTokenB", body.refresh_token);
    bru.setVar("userBId", body.user.id);
  }
}

tests {
  test("verified and logged in", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Before sending:** paste the OTP code (from staging logs, `Request OTP User B` above) into the environment variable `otpCodeB` — Environment settings, top right. Codes are single-use and short-lived; if this returns 400/410, request a fresh one and paste again.
}

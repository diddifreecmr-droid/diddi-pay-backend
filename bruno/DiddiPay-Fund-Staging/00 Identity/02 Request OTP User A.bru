meta {
  name: Request OTP User A
  type: http
  seq: 2
}

post {
  url: {{identityBaseUrl}}/auth/otp/request
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userAEmail}}",
    "channel": "email"
  }
}

tests {
  test("otp requested", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Response `channel` may come back `logging` if staging has no e-mail transport configured — the code lands in server logs either way.
}

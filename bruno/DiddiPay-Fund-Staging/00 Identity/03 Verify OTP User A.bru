meta {
  name: Verify OTP User A
  type: http
  seq: 3
}

post {
  url: {{identityBaseUrl}}/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userAEmail}}",
    "code": "{{otpCodeA}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setVar("accessTokenA", body.access_token);
    bru.setVar("refreshTokenA", body.refresh_token);
    bru.setVar("userAId", body.user.id);
  }
}

tests {
  test("verified and logged in", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Before sending:** paste the OTP code (from staging logs, `Request OTP User A` above) into the environment variable `otpCodeA` — Environment settings, top right. Codes are single-use and short-lived; if this returns 400/410, request a fresh one and paste again.
}

meta {
  name: PIN Change Requires Auth
  type: http
  seq: 4
}

post {
  url: {{payfundBaseUrl}}/wallet/pin/change
  body: json
  auth: none
}

body:json {
  {
    "current_pin": "1234",
    "new_pin": "5678",
    "confirm_new_pin": "5678"
  }
}

tests {
  test("PIN change is protected", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

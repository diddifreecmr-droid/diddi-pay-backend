meta {
  name: QR Verify Invalid Payload
  type: http
  seq: 6
}

post {
  url: {{payfundBaseUrl}}/wallet/qr/verify
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "payload": "not-a-valid-qr-token"
  }
}

tests {
  test("returns 422 INVALID_QR_CODE", function() {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("INVALID_QR_CODE");
  });
}

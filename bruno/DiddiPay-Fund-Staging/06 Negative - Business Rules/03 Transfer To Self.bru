meta {
  name: Transfer To Self
  type: http
  seq: 3
}

post {
  url: {{payfundBaseUrl}}/wallet/transfer
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "recipient_phone": "{{userAPhone}}",
    "amount": 1000,
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("returns 422 CANNOT_TRANSFER_TO_SELF", function() {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("CANNOT_TRANSFER_TO_SELF");
  });
}

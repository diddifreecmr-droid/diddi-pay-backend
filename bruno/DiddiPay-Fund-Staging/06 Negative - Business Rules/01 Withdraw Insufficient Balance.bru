meta {
  name: Withdraw Insufficient Balance
  type: http
  seq: 1
}

post {
  url: {{payfundBaseUrl}}/wallet/withdraw
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "provider": "orange_money",
    "amount": 1000000000000,
    "phone": "+2250700000000",
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("returns 409 INSUFFICIENT_BALANCE", function() {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("INSUFFICIENT_BALANCE");
  });
}

docs {
  Amount is deliberately absurd so this stays true no matter what an earlier deposit in this run left in the balance.
}

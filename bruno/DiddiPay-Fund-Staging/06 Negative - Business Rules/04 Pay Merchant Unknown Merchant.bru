meta {
  name: Pay Merchant Unknown Merchant
  type: http
  seq: 4
}

post {
  url: {{payfundBaseUrl}}/wallet/pay/merchant
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "merchant_account_id": "41e2ba56-6a82-4fba-9634-6fb30753a91c",
    "amount": 1000,
    "pin": "{{walletPinA}}"
  }
}

script:pre-request {
  bru.setVar("idemKey", Date.now() + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("returns 404 MERCHANT_NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("MERCHANT_NOT_FOUND");
  });
}

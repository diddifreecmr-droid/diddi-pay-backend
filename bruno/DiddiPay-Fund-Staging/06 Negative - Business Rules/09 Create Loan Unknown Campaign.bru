meta {
  name: Create Loan Unknown Campaign
  type: http
  seq: 9
}

post {
  url: {{payfundBaseUrl}}/fund/loans
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "amount": 50000,
    "duration_months": 6,
    "campaign_id": "41e2ba56-6a82-4fba-9634-6fb30753a91c"
  }
}

tests {
  test("returns 404 CAMPAIGN_NOT_FOUND", function() {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("CAMPAIGN_NOT_FOUND");
  });
}

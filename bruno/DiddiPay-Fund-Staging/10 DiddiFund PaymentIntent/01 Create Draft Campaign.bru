meta {
  name: Create Draft Campaign For Payment
  type: http
  seq: 1
}

post {
  url: {{payfundBaseUrl}}/fund/campaigns
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "title": "Bruno Payment Campaign {{paymentTestRunId}}",
    "goal_amount": 1000000,
    "currency": "XOF"
  }
}

script:pre-request {
  const token = bru.getProcessEnv("BRUNO_ACCESS_TOKEN_A");
  if (!token) {
    throw new Error("BRUNO_ACCESS_TOKEN_A is required for the DiddiFund suite");
  }
  const runId = Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
  bru.setVar("accessTokenA", token);
  bru.setVar("paymentTestRunId", runId);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("fundPaymentCampaignId", res.getBody().campaign_id);
  }
}

tests {
  test("draft campaign is created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("draft");
  });
}

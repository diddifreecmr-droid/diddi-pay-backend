meta {
  name: Unsigned DiddiPay Callback
  type: http
  seq: 4
}

post {
  url: {{payfundBaseUrl}}/fund/payments/webhooks/diddipay
  body: json
  auth: none
}

headers {
  X-DiddiPay-Event-ID: 7c47cc1a-e2fa-47a5-97bb-58b7cb57c725
}

body:json {
  {
    "id": "7c47cc1a-e2fa-47a5-97bb-58b7cb57c725",
    "type": "payment.succeeded",
    "occurred_at": "2026-08-15T12:00:00Z",
    "data": {
      "payment_intent_id": "41e2ba56-6a82-4fba-9634-6fb30753a91c",
      "business_reference": "forged-event",
      "amount": 5000,
      "currency": "XOF",
      "status": "succeeded"
    }
  }
}

tests {
  test("unsigned module callback is rejected", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("UNAUTHENTICATED");
  });
}

docs {
  This cannot create an investment because the required HMAC signature is absent.
}

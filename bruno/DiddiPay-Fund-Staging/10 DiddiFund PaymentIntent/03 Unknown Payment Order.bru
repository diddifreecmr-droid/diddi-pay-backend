meta {
  name: Unknown Payment Order
  type: http
  seq: 3
}

get {
  url: {{payfundBaseUrl}}/fund/payment-orders/41e2ba56-6a82-4fba-9634-6fb30753a91c
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test("unknown order is hidden", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error.code).to.equal("PAYMENT_ORDER_NOT_FOUND");
  });
}

meta {
  name: No Token - Get Balance
  type: http
  seq: 1
}

get {
  url: {{payfundBaseUrl}}/wallet/balance
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function() {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("UNAUTHENTICATED");
  });
}

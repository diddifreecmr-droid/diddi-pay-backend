meta {
  name: No Token - Create Campaign
  type: http
  seq: 3
}

post {
  url: {{payfundBaseUrl}}/fund/campaigns
  body: json
  auth: none
}

body:json {
  {
    "title": "x",
    "goal_amount": 1000
  }
}

tests {
  test("returns 401 UNAUTHENTICATED", function() {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.equal("UNAUTHENTICATED");
  });
}

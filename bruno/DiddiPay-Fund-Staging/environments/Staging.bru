  otpCodeA: {{process.env.BRUNO_OTP_CODE_A}}
  accessTokenA: {{process.env.BRUNO_ACCESS_TOKEN_A}}
  refreshTokenA: {{process.env.BRUNO_REFRESH_TOKEN_A}}
  userBEmail: {{process.env.BRUNO_USER_B_EMAIL}}
  userBPhone: {{process.env.BRUNO_USER_B_PHONE}}
  userBId: {{process.env.BRUNO_USER_B_ID}}
  otpCodeB: {{process.env.BRUNO_OTP_CODE_B}}
  accessTokenB: {{process.env.BRUNO_ACCESS_TOKEN_B}}
  refreshTokenB: {{process.env.BRUNO_REFRESH_TOKEN_B}}
  adminAccessToken: {{process.env.BRUNO_ADMIN_ACCESS_TOKEN}}
  walletPinA: {{process.env.BRUNO_WALLET_PIN_A}}
  walletPinB: {{process.env.BRUNO_WALLET_PIN_B}}
  paymentClientId: diddigo
  paymentServiceKey: {{process.env.BRUNO_DIDDIPAY_SERVICE_KEY}}
  otherPaymentClientId: diddifund
  otherPaymentServiceKey: {{process.env.BRUNO_DIDDIFUND_SERVICE_KEY}}
  paymentCustomerEmail: {{process.env.BRUNO_PAYMENT_CUSTOMER_EMAIL}}
  paymentTestRunId:
  paymentIdempotencyKey:
  paymentBusinessReference:
  paymentIntentId:
  campaignId:
  fundPaymentCampaignId:
  paymentOrderId:
  loanId:

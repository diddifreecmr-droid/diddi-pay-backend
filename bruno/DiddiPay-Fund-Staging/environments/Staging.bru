vars {
  payfundBaseUrl: https://pay-api-staging.diddifree.com/payfund/v1
  identityBaseUrl: https://auth-staging.diddifree.com/identity/v1
  userAEmail: {{process.env.BRUNO_USER_A_EMAIL}}
  userAPhone: {{process.env.BRUNO_USER_A_PHONE}}

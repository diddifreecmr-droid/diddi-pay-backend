# DiddiPay provider profile: CinetPay.
# CinetPay is currently a PaymentIntent/Payout adapter only; the legacy wallet rail stays stub.
# Load after the general file. Keep real values in an ignored .env.cinetpay file or Portainer.

PAYMENT_GATEWAY_MODE=stub
PAYMENT_PROCESSOR_MODE=cinetpay
PAYMENT_GATEWAY_AUTOCONFIRM=false

CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_BASE_URL=https://api.cinetpay.net
CINETPAY_COUNTRY=CI
# Public HTTPS endpoint configured as CinetPay notify_url.
CINETPAY_WEBHOOK_URL=https://pay-api-staging.diddifree.com/payfund/v1/payments/webhooks/cinetpay

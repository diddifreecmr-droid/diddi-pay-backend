# Staging 2.0.0. Exports disabled until central routes are confirmed.
# Preserve existing Portainer metrics secrets; missing keys here MUST NOT erase them.
# Inject OTEL_EXPORTER_OTLP_HEADERS from the private handoff; never commit it.
OTEL_SERVICE_NAME=diddipay
ENVIRONMENT=staging
DEPLOYMENT_ID=diddipay-staging
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddipay
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddipay/v1/logs
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddipay/v1/traces
OTEL_LOGS_ENABLED=false
TRACING_ENABLED=false
# OBSERVABILITY_RELEASE_SHA=<actual-built-commit>
# Keep existing METRICS_TOKEN / METRICS_BEARER_TOKEN or component tokens in Portainer.

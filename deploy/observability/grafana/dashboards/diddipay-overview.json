{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "up{job=\"diddipay\"}", "refId": "A"}],
      "title": "DiddiPay Up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(rate(diddipay_http_requests_total[5m]))", "refId": "A"}],
      "title": "HTTP Request Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(rate(diddipay_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(diddipay_http_requests_total[5m])), 0.001)", "refId": "A"}],
      "title": "HTTP 5xx Ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "diddipay_outbox_events{status=\"dead_letter\"}", "refId": "A"}],
      "title": "Dead Letters",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(increase(diddipay_payment_intents_created_total[1h]))", "refId": "A"}],
      "title": "PaymentIntents / hour",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 6,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (status_code) (rate(diddipay_http_requests_total[5m]))", "legendFormat": "HTTP {{status_code}}", "refId": "A"}],
      "title": "HTTP Throughput by Status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(diddipay_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "HTTP p95 Latency by Route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 8,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, provider, operation) (rate(diddipay_provider_call_duration_seconds_bucket[5m])))", "legendFormat": "{{provider}} {{operation}}", "refId": "A"}],
      "title": "Provider p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 9,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (outcome) (increase(diddipay_webhook_events_total[15m]))", "legendFormat": "webhook {{outcome}}", "refId": "A"},
        {"expr": "sum by (outcome) (increase(diddipay_outbox_deliveries_total[15m]))", "legendFormat": "callback {{outcome}}", "refId": "B"}
      ],
      "title": "Webhooks and Module Callbacks",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "diddipay-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 20},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "diddipay_outbox_events", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Payment Callback Outbox",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["diddipay", "payments", "mvp"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "DiddiPay Overview",
  "uid": "diddipay-overview",
  "version": 1
}

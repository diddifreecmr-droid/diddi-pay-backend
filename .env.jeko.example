# DiddiPay provider profile: Jeko.
# There is no Jeko sandbox; use only an approved test store. The legacy wallet rail stays stub.
# Load after the general file. Keep real values in an ignored .env.jeko file or Portainer.

PAYMENT_GATEWAY_MODE=stub
PAYMENT_PROCESSOR_MODE=jeko
PAYMENT_GATEWAY_AUTOCONFIRM=false

JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_BASE_URL=https://api.jeko.africa
JEKO_WEBHOOK_SECRET=

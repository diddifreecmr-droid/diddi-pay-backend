# DiddiPay provider profile: Paystack.
# Load after the general file. Keep real values in an ignored .env.paystack file or Portainer.

# Paystack is used for the legacy wallet rail and PaymentIntent collection/refunds.
# Payout is not supported by the Paystack adapter in this project.
PAYMENT_GATEWAY_MODE=paystack
PAYMENT_PROCESSOR_MODE=paystack
PAYMENT_GATEWAY_AUTOCONFIRM=false

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ENVIRONMENT=test
